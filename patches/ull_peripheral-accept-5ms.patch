diff --git a/subsys/bluetooth/controller/ll_sw/lll.h b/subsys/bluetooth/controller/ll_sw/lll.h
index f35589af6fc..5464d790040 100644
--- a/subsys/bluetooth/controller/ll_sw/lll.h
+++ b/subsys/bluetooth/controller/ll_sw/lll.h
@@ -21,6 +21,25 @@
 #define PERIODIC_INT_UNIT_US     CONN_INT_UNIT_US
 #define CONN_LOW_LAT_INT_UNIT_US 500U
 
+/*
+ * Pair-Raught: the Nintendo Switch 2 opens controller connections with a
+ * CONNECT_IND carrying interval=4 (4 x 1250 us = 5.00 ms), below the Bluetooth
+ * spec floor BT_HCI_LE_INTERVAL_MIN (6 units = 7.5 ms). ull_peripheral.c is
+ * patched to accept it.
+ *
+ * This threshold has to move with it, because the controller ALSO uses "below
+ * the spec floor" to select the proprietary LOW LATENCY encoding, in which the
+ * interval means (interval + 1) * CONN_LOW_LAT_INT_UNIT_US. For interval=4 that
+ * is 5 * 500 = 2500 us -- exactly HALF what the Switch means. Accepting the
+ * connection without also moving this made the puck anchor at 2.5 ms against a
+ * console at 5 ms; the link then died within a few seconds with reason 0x1e
+ * (invalid LL parameters), reproducibly.
+ *
+ * So the standard 1250 us units must apply from 4 upwards. Used in ull_conn.c
+ * everywhere a connection interval is converted to microseconds.
+ */
+#define RAUGHT_LE_INTERVAL_MIN 4U
+
 #define ISO_INTERVAL_TO_US(interval) ((interval) * ISO_INT_UNIT_US)
 
 /* Timeout for Host to accept/reject cis create request */
