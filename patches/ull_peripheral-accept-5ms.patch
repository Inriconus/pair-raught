diff --git a/subsys/bluetooth/controller/ll_sw/ull_peripheral.c b/subsys/bluetooth/controller/ll_sw/ull_peripheral.c
index aa6db211ed1..404edc23ae8 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_peripheral.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_peripheral.c
@@ -60,6 +60,15 @@
 
 #include "hal/debug.h"
 
+/*
+ * Pair-Raught: RAUGHT_LE_INTERVAL_MIN (the lowest connection interval accepted
+ * in a CONNECT_IND, in 1.25 ms units) now lives in lll.h, because ull_conn.c
+ * needs the SAME threshold to pick the right time unit when converting the
+ * interval to microseconds. Defining it in two places let the two disagree:
+ * this file accepted interval=4 while ull_conn.c still treated anything under 6
+ * as the low-latency encoding and ran the link at 2.5 ms instead of 5 ms.
+ */
+
 static void invalid_release(struct ull_hdr *hdr, struct lll_conn *lll,
 			    memq_link_t *link, struct node_rx_pdu *rx);
 static void ticker_op_stop_adv_cb(uint32_t status, void *param);
@@ -157,10 +166,27 @@ void ull_periph_setup(struct node_rx_pdu *rx, struct node_rx_ftr *ftr,
 			       sizeof(lll->data_chan_map));
 	lll->data_chan_hop = pdu_adv->connect_ind.hop;
 	lll->interval = sys_le16_to_cpu(pdu_adv->connect_ind.interval);
+	/*
+	 * Pair-Raught: accept connection intervals below the 7.5 ms (6 unit) floor
+	 * that BT_HCI_LE_INTERVAL_MIN encodes.
+	 *
+	 * The Nintendo Switch 2 opens controller connections with interval=4
+	 * (5.00 ms), which is out of spec. Nintendo's own controllers accept it:
+	 * a real Joy-Con's reconnect CONNECT_IND is also interval=4 and the link
+	 * runs for minutes. Rejecting it here is silent and total -- the
+	 * peripheral never transmits, so the central sees a device that simply
+	 * does not answer. Measured on air 2026-08-15 with the S140 SoftDevice,
+	 * which enforces the same rule where it cannot be reached: 213
+	 * CONNECT_INDs at interval=4 all unanswered, versus the single
+	 * interval=12 (15 ms) offer that connected and ran for 33 s.
+	 *
+	 * This is deliberately NOT spec compliant. It is the entire reason this
+	 * project uses Zephyr's software controller rather than a binary one.
+	 */
 	if ((lll->data_chan_count < CHM_USED_COUNT_MIN) ||
 	    (lll->data_chan_hop < CHM_HOP_COUNT_MIN) ||
 	    (lll->data_chan_hop > CHM_HOP_COUNT_MAX) ||
-	    !IN_RANGE(lll->interval, BT_HCI_LE_INTERVAL_MIN, BT_HCI_LE_INTERVAL_MAX)) {
+	    !IN_RANGE(lll->interval, RAUGHT_LE_INTERVAL_MIN, BT_HCI_LE_INTERVAL_MAX)) {
 		invalid_release(&adv->ull, lll, link, rx);
 
 		return;
